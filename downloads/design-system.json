  "imagery": {
    "style": "Authentische Fotografie — keine gestellten Stock-Bilder",
    "subjects": "Jugendliche im echten Einsatz",
    "criteria": [
      "Authentische Situationen",
      "Sichtbare Verantwortung",
      "Nähe zu den Menschen",
      "Teamgeist",
      "Kompetenz & Professionalität"
    ],
